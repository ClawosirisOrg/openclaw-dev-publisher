{
  "id": "openclaw-dev-publisher",
  "name": "Signed dev-agent publisher",
  "description": "Disabled by default; explicit protected-config Gateway broker",
  "categories": [
    "developer-tools"
  ],
  "activation": {
    "onStartup": false
  },
  "contracts": {
    "tools": [
      "request_signed_publication"
    ]
  },
  "toolMetadata": {
    "request_signed_publication": {
      "optional": true
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mode": {
        "type": "string",
        "enum": [
          "disabled",
          "production"
        ],
        "default": "disabled"
      },
      "productionConfigPath": {
        "type": "string",
        "pattern": "^/",
        "description": "Gateway-owned protected JSON path reference; never a key or token"
      }
    },
    "allOf": [
      {
        "if": {
          "required": [
            "mode"
          ],
          "properties": {
            "mode": {
              "const": "production"
            }
          }
        },
        "then": {
          "required": [
            "productionConfigPath"
          ]
        }
      }
    ]
  }
}

{
  "name": "openclaw-dev-publisher-prototype",
  "version": "0.0.0",
  "private": true,
  "description": "Inert Gateway-side signed dev-agent publication pattern prototype",
  "type": "module",
  "license": "MIT",
  "openclaw": {
    "extensions": ["./src/plugin.mjs"],
    "compat": { "pluginApi": ">=2026.10.3" },
    "install": { "minHostVersion": ">=2026.10.3" }
  },
  "files": ["src/", "openclaw.plugin.json", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --test",
    "test:python": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s broker/tests -p 'test_*.py' -q",
    "test:all": "npm test && npm run test:python"
  },
  "engines": { "node": ">=20" }
}
